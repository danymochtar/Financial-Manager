# Copy ke .env dan isi nilainya

# === Database (Neon Postgres) ===
# Pooled connection (dipake app runtime) — dari Neon dashboard pilih "Pooled connection"
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct connection (dipake buat `prisma migrate`) — dari Neon dashboard pilih "Direct connection"
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# === NextAuth ===
# Generate via: openssl rand -base64 32
NEXTAUTH_SECRET="ganti-dengan-string-random-panjang"
# Production: https://your-app.vercel.app ; Local: http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"

# === Anthropic API (receipt OCR) ===
ANTHROPIC_API_KEY="sk-ant-api03-xxxxx"
# Model vision: claude-sonnet-4-6 (default) atau claude-opus-4-7 untuk akurasi tinggi
ANTHROPIC_VISION_MODEL="claude-sonnet-4-6"

# === Vercel Blob (storage receipt images) ===
# Auto-injected saat Blob store di-link ke project di Vercel.
# Untuk local dev: generate di Vercel dashboard → Storage → Blob → ".env.local tab" → copy.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxx"
