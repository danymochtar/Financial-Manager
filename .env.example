# Copy ke .env dan isi nilainya

# SQLite file path (relative ke folder prisma/)
DATABASE_URL="file:./dev.db"

# NextAuth
# Generate via: openssl rand -base64 32
NEXTAUTH_SECRET="ganti-dengan-string-random-panjang"
NEXTAUTH_URL="http://localhost:3000"

# Anthropic API — buat receipt OCR
ANTHROPIC_API_KEY="sk-ant-api03-xxxxx"
# Model vision: claude-sonnet-4-6 (default) atau claude-opus-4-7 untuk akurasi tinggi
ANTHROPIC_VISION_MODEL="claude-sonnet-4-6"

# Storage path untuk receipt images (relative ke project root)
STORAGE_DIR="./storage"
