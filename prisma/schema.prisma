// "Seberapa Boros Lo?" — data model (PostgreSQL)
// Dual-base currency (IDR + MYR) tetap: Transaction nyimpen snapshot
// amountIDR & amountMYR, Account punya currency sendiri.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  name            String
  primaryCurrency String   @default("IDR")
  onboardingDone  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  accounts       Account[]
  categories     Category[]
  transactions   Transaction[]
  receipts       Receipt[]
  balanceUploads BalanceUpload[]
  budgets        Budget[]
  debts          Debt[]
  dependents     Dependent[]
  fixedIncomes   FixedIncome[]
  fixedExpenses  FixedExpense[]
  investments    Investment[]
  goals          Goal[]
  assets         Asset[]
  jobRecords     JobRecord[]
}

// Rekening, e-money, cash, kartu kredit.
model Account {
  id          String   @id @default(cuid())
  userId      String
  name        String
  type        String // "bank" | "ewallet" | "cash" | "credit_card"
  currency    String
  balance     Decimal  @default(0)
  creditLimit Decimal? // cuma buat credit_card
  color       String   @default("#ec4899")
  emoji       String   @default("💳")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  fixedIncomes  FixedIncome[]
  fixedExpenses FixedExpense[]
  debts         Debt[]

  @@unique([userId, name])
  @@index([userId])
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  kind      String // "income" | "expense"
  nature    String   @default("variable") // "fixed" | "variable"
  emoji     String   @default("🏷️")
  color     String   @default("#ec4899")
  createdAt DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  budgets       Budget[]
  fixedExpenses FixedExpense[]

  @@unique([userId, name, kind])
  @@index([userId])
}

model Transaction {
  id         String   @id @default(cuid())
  userId     String
  accountId  String
  categoryId String
  type       String // "income" | "expense" | "transfer"
  amount     Decimal
  currency   String
  amountIDR  Decimal
  amountMYR  Decimal
  date       DateTime
  merchant   String?
  note       String?
  isBoros    Boolean  @default(false) // user-tagged "ini kalap"
  receiptId  String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account  @relation(fields: [accountId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])
  receipt  Receipt? @relation(fields: [receiptId], references: [id])

  @@index([userId, date])
  @@index([accountId])
  @@index([categoryId])
}

model Receipt {
  id          String    @id @default(cuid())
  userId      String
  imagePath   String
  mimeType    String
  rawOcrJson  String?
  merchant    String?
  totalAmount Decimal?
  currency    String?
  date        DateTime?
  status      String    @default("draft") // "draft" | "confirmed" | "discarded"
  batchId     String? // kalau di-capture batch, group-nya
  createdAt   DateTime  @default(now())

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction?
  items       ReceiptItem[]

  @@index([userId, status])
  @@index([batchId])
}

model ReceiptItem {
  id                 String   @id @default(cuid())
  receiptId          String
  name               String
  quantity           Decimal?
  unitPrice          Decimal?
  total              Decimal?
  categorySuggestion String?

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}

// Screenshot banking app → OCR → update Account.balance
model BalanceUpload {
  id                   String   @id @default(cuid())
  userId               String
  accountId            String?
  imagePath            String
  mimeType             String
  rawOcrJson           String?
  extractedBalance     Decimal?
  extractedAccountName String?
  currency             String?
  status               String   @default("draft") // "draft" | "applied" | "discarded"
  createdAt            DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Budget {
  id         String   @id @default(cuid())
  userId     String
  scope      String // "overall" | "category"
  categoryId String?
  period     String // "daily" | "weekly" | "monthly"
  amount     Decimal
  currency   String
  startDate  DateTime
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  @@unique([userId, scope, categoryId, period, currency])
  @@index([userId])
}

model FixedIncome {
  id         String   @id @default(cuid())
  userId     String
  accountId  String? // rekening yang nerima
  name       String // "Gaji Kerjaan Malaysia"
  amount     Decimal
  currency   String
  cadence    String   @default("monthly") // "monthly" | "weekly"
  dayOfMonth Int?
  nextDue    DateTime
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id])

  @@index([userId, isActive])
}

model FixedExpense {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  accountId  String? // rekening yang mbayar
  name       String // "Sewa Kost", "Netflix"
  amount     Decimal
  currency   String
  cadence    String   @default("monthly")
  dayOfMonth Int?
  nextDue    DateTime
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])
  account  Account? @relation(fields: [accountId], references: [id])

  @@index([userId, isActive])
}

model Debt {
  id              String    @id @default(cuid())
  userId          String
  accountId       String? // source bayar
  name            String // "KPR BCA", "Cicilan Motor"
  totalPrincipal  Decimal
  remainingAmount Decimal
  monthlyPayment  Decimal
  currency        String
  interestRate    Decimal?
  endDate         DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id])

  @@index([userId])
}

model Dependent {
  id            String   @id @default(cuid())
  userId        String
  name          String // "Mama", "Ade Bungsu"
  relationship  String // "parent" | "sibling" | "child" | "partner" | "other"
  monthlyAmount Decimal
  currency      String
  note          String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Aset investasi: emas, crypto, saham, reksadana, dll.
// Value di-input manual (pake screenshot OCR nanti sbg stretch).
model Investment {
  id           String   @id @default(cuid())
  userId       String
  name         String // "Bitcoin", "Emas Antam", "BBCA"
  type         String // "gold" | "crypto" | "stock" | "mutual_fund" | "forex" | "deposit" | "bond" | "property" | "other"
  platform     String? // "Pluang", "Indodax", "Ajaib", "BCA Deposito"
  currentValue Decimal
  currency     String
  emoji        String   @default("📈")
  color        String   @default("#10b981")
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Target hidup — nikah, haji, mobil, dll. Dukun AI pake data ini buat bikin plan.
model Goal {
  id           String    @id @default(cuid())
  userId       String
  name         String
  emoji        String    @default("🎯")
  targetAmount Decimal
  currency     String
  currentSaved Decimal   @default(0)
  targetDate   DateTime?
  priority     Int       @default(2) // 1=high, 2=normal, 3=low
  note         String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

// Aset fisik: properti, kendaraan, gadget, collectibles.
// Value di-revalue bulanan via Claude (AI estimate) atau manual.
model Asset {
  id              String   @id @default(cuid())
  userId          String
  name            String // "Brio 2020 Silver", "Apartment Taman Anggrek"
  type            String // "property" | "vehicle" | "electronics" | "collectible" | "other"
  subtype         String? // "house"|"apartment"|"land"|"car"|"motorcycle"|"phone"|"laptop"|"watch"|...
  emoji           String   @default("🏠")
  purchasePrice   Decimal
  purchaseDate    DateTime
  currentValue    Decimal
  currency        String
  lastValuationAt DateTime @default(now())
  valuationMethod String   @default("manual") // "manual" | "ai_estimate"
  valuationNote   String? // reasoning dari AI
  details         String? // JSON: {brand, model, year, mileage, size, location, ...}
  note            String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

// Riwayat karir — buat narasi "udah kerja berapa tahun, total earning".
model JobRecord {
  id            String    @id @default(cuid())
  userId        String
  employer      String
  role          String?
  startDate     DateTime
  endDate       DateTime? // null = current
  monthlySalary Decimal
  currency      String
  country       String    @default("ID")
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FxRate {
  date         DateTime
  fromCurrency String
  toCurrency   String
  rate         Decimal
  fetchedAt    DateTime @default(now())

  @@id([date, fromCurrency, toCurrency])
}
